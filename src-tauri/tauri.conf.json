{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PvZ2_GE",
  "version": "0.15.21",
  "identifier": "com.pvzge.game",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PvZ2: Gardendless",
        "width": 975,
        "height": 608,
        "minWidth": 515,
        "minHeight": 304,
        "dragDropEnabled": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}